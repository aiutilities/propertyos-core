{
  "name": "backend",
  "version": "1.0.0",
  "description": "This folder will contain backend implementation later.",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/main.ts",
    "build": "tsc",
    "dev": "ts-node src/main.ts",
    "migrate": "ts-node src/database/runner/migration-runner.ts",
    "test": "jest",
    "test:integration": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "start:prod": "node dist/main.js",
    "migrate:prod": "node dist/database/runner/migration-runner.js",
    "start:scheduler": "ts-node src/scheduler-worker.ts",
    "start:scheduler:prod": "node dist/scheduler-worker.js",
    "knowledge:controllers:ast": "NODE_PATH=./node_modules ts-node --project tools/knowledge-engine/tsconfig.json tools/knowledge-engine/controller-ast-extractor.ts .. ../generated/knowledge/controllers.ast.json",
    "knowledge:controllers:ast:typecheck": "tsc --project tools/knowledge-engine/tsconfig.json --noEmit",
    "knowledge:controllers": "cd .. && python3 -m tools.knowledge_engine.controller_cli",
    "knowledge:controllers:regex": "cd .. && python3 -m tools.knowledge_engine.controller_cli --engine regex --output generated/knowledge/controllers.regex.json",
    "knowledge:controllers:parity": "cd .. && python3 tests/knowledge_engine/compare_controller_manifests.py",
    "knowledge:architecture": "cd .. && python3 -m tools.knowledge_engine.architecture_cli",
    "knowledge:ir": "cd .. && python3 -m tools.knowledge_engine.repository_ir_cli",
    "knowledge:dependencies:ast": "NODE_PATH=./node_modules ts-node --project tools/knowledge-engine/tsconfig.json tools/knowledge-engine/module-dependency-extractor.ts .. ../generated/knowledge/module-dependencies.ast.json",
    "knowledge:dependencies": "cd .. && python3 -m tools.knowledge_engine.dependency_graph_cli",
    "knowledge:impact": "cd .. && python3 -m tools.knowledge_engine.impact_analysis_cli",
    "knowledge:docs:modules": "cd .. && python3 -m tools.knowledge_engine.module_documentation_cli",
    "knowledge:repository:verify": "cd .. && python3 -m tools.knowledge_engine.repository_api_cli",
    "knowledge:query": "cd .. && python3 -m tools.knowledge_engine.query_cli",
    "knowledge:context": "cd .. && python3 -m tools.knowledge_engine.context_cli",
    "knowledge:migration": "cd .. && python3 -m tools.knowledge_engine.migration_cli"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@types/semver": "^7.7.1",
    "adm-zip": "^0.5.18",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
