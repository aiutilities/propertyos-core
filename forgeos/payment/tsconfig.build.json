{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2021",
    "moduleResolution": "Node16",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "types": [
      "node"
    ],
    "typeRoots": [
      "../../backend/node_modules/@types"
    ],

    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "index.ts",
    "contracts/**/*.ts",
    "dispatcher/**/*.ts",
    "ports/**/*.ts",
    "providers/**/*.ts",
    "registry/**/*.ts"
  ],
  "exclude": [
    "dist",
    "tests",
    "**/*.integration-spec.ts",
    "**/*.spec.ts"
  ]
}
