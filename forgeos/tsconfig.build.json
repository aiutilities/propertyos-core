{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2021",
    "moduleResolution": "Node16",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "communication/**/*.ts",
    "packages/communication-contracts/src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "communication/tests",
    "**/*.integration-spec.ts",
    "**/*.spec.ts"
  ]
}
