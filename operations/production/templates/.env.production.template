# PropertyOS production environment template
# Replace every placeholder outside version control.

NODE_ENV=production
PORT=3000

POSTGRES_HOST=<POSTGRES_HOST>
POSTGRES_PORT=5432
POSTGRES_DB=<POSTGRES_DB>
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<SECRET_FROM_APPROVED_SECRET_STORE>

AUTH_SECRET=<SECRET_AT_LEAST_32_CHARACTERS>

CORS_ORIGIN=https://<PROPERTYOS_PUBLIC_HOST>

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

STORAGE_LOCAL_ROOT=/app/uploads

SCHEDULER_POLL_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=25
SCHEDULER_STALE_AFTER_MS=300000
SCHEDULER_RETRY_BASE_DELAY_MS=1000
SCHEDULER_MAX_RETRY_DELAY_MS=60000
