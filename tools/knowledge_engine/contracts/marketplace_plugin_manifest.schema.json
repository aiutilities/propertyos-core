{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propertyos.org/contracts/marketplace-plugin-manifest.schema.json",
  "title": "PropertyOS Marketplace Plugin Manifest",
  "description": "Stable marketplace admission and runtime compatibility contract for PropertyOS plugins.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "publisher",
    "engine",
    "contracts",
    "permissions",
    "migrations",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostApi",
        "node"
      ],
      "properties": {
        "hostApi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "maximum": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "version"
        ],
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^@propertyos/[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^dist/[A-Za-z0-9_./-]+\\.js$",
      "default": "dist/index.js"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "configuration",
          "dashboard",
          "documents",
          "notifications",
          "permissions",
          "scheduler",
          "search",
          "workflow"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pluginId",
          "version"
        ],
        "properties": {
          "pluginId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "reversible"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "none",
            "ordered-sql"
          ]
        },
        "directory": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "reversible": {
          "type": "boolean"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "string",
          "pattern": "^dist/[A-Za-z0-9_./-]+\\.js$"
        },
        "activate": {
          "type": "string",
          "pattern": "^dist/[A-Za-z0-9_./-]+\\.js$"
        },
        "deactivate": {
          "type": "string",
          "pattern": "^dist/[A-Za-z0-9_./-]+\\.js$"
        },
        "uninstall": {
          "type": "string",
          "pattern": "^dist/[A-Za-z0-9_./-]+\\.js$"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "archiveSha256"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "archiveSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "keyId",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "ed25519"
              ]
            },
            "keyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
